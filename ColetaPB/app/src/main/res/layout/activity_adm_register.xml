<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img_trash_truck_blue2"
    tools:context=".AdmRegister">

    <ImageView
        android:id="@+id/ivTrashTruck"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_trash_truck_white" />

    <TextView
        android:id="@+id/tvAdmRegister"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Cadastro de Administrador"
        android:textColor="#F2F1F1"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="@+id/ivTrashTruck"
        app:layout_constraintStart_toStartOf="@+id/ivTrashTruck"
        app:layout_constraintTop_toBottomOf="@id/ivTrashTruck" />

    <EditText
        android:id="@+id/etAdmNameRegister"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/edittext_border"
        android:ems="10"
        android:hint="  Nome"
        android:inputType="text"
        android:textColorHint="#FDFDFD"
        app:layout_constraintEnd_toEndOf="@+id/tvAdmRegister"
        app:layout_constraintStart_toStartOf="@+id/tvAdmRegister"
        app:layout_constraintTop_toBottomOf="@+id/tvAdmRegister" />

    <EditText
        android:id="@+id/etAdmCPFRegister"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/edittext_border"
        android:ems="10"
        android:hint="  CPF"
        android:inputType="number"
        android:textColorHint="#FDFDFD"
        app:layout_constraintEnd_toEndOf="@+id/etAdmNameRegister"
        app:layout_constraintStart_toStartOf="@+id/etAdmNameRegister"
        app:layout_constraintTop_toBottomOf="@+id/etAdmNameRegister" />

    <EditText
        android:id="@+id/etAdmBadgeRegister"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/edittext_border"
        android:ems="10"
        android:hint="  Crachá"
        android:inputType="number"
        android:textColorHint="#FDFDFD"
        app:layout_constraintEnd_toEndOf="@+id/etAdmCPFRegister"
        app:layout_constraintStart_toStartOf="@+id/etAdmCPFRegister"
        app:layout_constraintTop_toBottomOf="@+id/etAdmCPFRegister" />

    <EditText
        android:id="@+id/etAdmPassword"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/edittext_border"
        android:ems="10"
        android:hint="  Senha"
        android:inputType="textPassword"
        android:textColorHint="#FFFFFF"
        app:layout_constraintEnd_toEndOf="@+id/etAdmBadgeRegister"
        app:layout_constraintStart_toStartOf="@+id/etAdmBadgeRegister"
        app:layout_constraintTop_toBottomOf="@+id/etAdmBadgeRegister" />

    <Button
        android:id="@+id/btAdmRegister"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/white"
        android:text="Registrar"
        android:textColor="@color/blue"
        app:layout_constraintEnd_toEndOf="@+id/etAdmPassword"
        app:layout_constraintTop_toBottomOf="@+id/etAdmPassword" />

    <TextView
        android:id="@+id/tvHaveRegister"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Já possuo uma conta"
        android:textColor="#FFFFFF"
        app:layout_constraintEnd_toEndOf="@+id/btAdmRegister"
        app:layout_constraintTop_toBottomOf="@+id/btAdmRegister" />

    <Button
        android:id="@+id/btLoginPage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/white"
        android:text="Logar"
        android:textColor="@color/blue"
        app:layout_constraintEnd_toEndOf="@+id/tvHaveRegister"
        app:layout_constraintTop_toBottomOf="@+id/tvHaveRegister" />

</androidx.constraintlayout.widget.ConstraintLayout>