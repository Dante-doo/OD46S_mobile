<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/img_trash_truck_blue2"
    tools:context=".CurrentAssignmentList">

    <!-- Cabeçalho da Tela -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Olá, Motorista!"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#F2F1F1"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Aqui está sua missão de hoje:"
        android:textSize="16sp"
        android:textColor="#F2F1F1"
        android:layout_marginBottom="24dp"/>

    <!-- Loading -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="visible"/>

    <!-- Mensagem Vazia -->
    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nenhuma escala encontrada para hoje."
        android:gravity="center"
        android:textSize="16sp"
        android:textColor="#F2F1F1"
        android:visibility="gone"/>

    <!-- CARD PRINCIPAL (Estilo Moderno com Imagem) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardAssignment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        android:foreground="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- 2. Scrim (Sombra para legibilidade) -->
            <View
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="#99000000"
                app:layout_constraintTop_toTopOf="parent"/>

            <!-- 3. Conteúdo sobre a Imagem -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <!-- Badge de Status -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESCALA ATIVA"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#F2F1F1"
                    android:background="#CC00C853"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:layout_marginBottom="16dp"/>

                <!-- Nome da Rota -->
                <TextView
                    android:id="@+id/tvRouteName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rota Centro"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

                <!-- Descrição da Rota -->
                <TextView
                    android:id="@+id/tvRouteInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Coleta Comercial"
                    android:textSize="16sp"
                    android:textColor="#F2F1F1"
                    android:layout_marginBottom="24dp"/>

                <!-- Divisor -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#40FFFFFF"
                    android:layout_marginBottom="16dp"/>

                <!-- Detalhes do Caminhão -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Ícone de Caminhão (Branco) -->
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_trash_truck_white"
                        android:layout_marginEnd="12dp"/>
                    <!-- Use seu ic_trash_truck_white aqui -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTruckPlate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ABC-1234"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#F2F1F1"/>

                        <TextView
                            android:id="@+id/tvTruckModel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Modelo Compactador"
                            android:textSize="14sp"
                            android:textColor="#CCCCCC"/>
                    </LinearLayout>

                    <!-- Seta de Ação -->
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_media_play"
                        app:tint="#FFFFFF"/>
                </LinearLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>