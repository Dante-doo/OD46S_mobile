<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:id="@+id/main"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:padding="16dp"
android:background="@drawable/img_trash_truck_blue2">

<TextView
    android:id="@+id/tvHeader"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:text="Rota XXX"
    android:textSize="24sp"
    android:textStyle="bold"
    android:textColor="@android:color/white"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"/>

<TextView
    android:id="@+id/tvSub"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:text="Bairros/Turno"
    android:textSize="16sp"
    android:textColor="@android:color/white"
    app:layout_constraintTop_toBottomOf="@id/tvHeader"
    app:layout_constraintStart_toStartOf="@id/tvHeader"
    app:layout_constraintEnd_toEndOf="@id/tvHeader"
    android:layout_marginTop="8dp"/>

    <!-- INICIAR (visível no começo) -->
    <Button
        android:id="@+id/btStart"
        android:layout_width="350dp"
        android:layout_height="150dp"
        android:layout_marginTop="32dp"
        android:text="INICIAR"
        android:textAllCaps="false"
        android:textSize="48sp"
        android:backgroundTint="@color/light_blue"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/tvSub"
        app:layout_constraintStart_toStartOf="@id/tvSub"
        app:layout_constraintEnd_toEndOf="@id/tvSub" />

    <!-- FINALIZAR (mesmo lugar, começa oculto) -->
    <Button
        android:id="@+id/btFinish"
        android:layout_width="350dp"
        android:layout_height="150dp"
        android:layout_marginTop="32dp"
        android:text="FINALIZAR"
        android:textAllCaps="false"
        android:textSize="36sp"
        android:backgroundTint="@android:color/holo_red_dark"
        android:textColor="@color/white"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvSub"
        app:layout_constraintStart_toStartOf="@id/tvSub"
        app:layout_constraintEnd_toEndOf="@id/tvSub" />

    <!-- Botão legacy (não usado diretamente na UI, mantido para compatibilidade de código) -->
    <Button
        android:id="@+id/btIncident"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Linha de ações de GPS -->
    <LinearLayout
        android:id="@+id/llGpsActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btStart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btPointCollected"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="COLETA REALIZADA"
            android:textAllCaps="false"
            android:backgroundTint="@color/light_blue"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btProblem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="IMPREVISTO"
            android:textAllCaps="false"
            android:backgroundTint="@color/light_blue"
            android:textColor="@color/white" />
    </LinearLayout>

    <!-- Cancelar rota com registro -->
    <Button
        android:id="@+id/btCancelRoute"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="32dp"
        android:text="CANCELAR ROTA"
        android:textAllCaps="false"
        android:backgroundTint="@android:color/holo_red_dark"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/llGpsActions"
        app:layout_constraintStart_toStartOf="@id/llGpsActions"
        app:layout_constraintEnd_toEndOf="@id/llGpsActions"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
