<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img_trash_truck_blue2"
    tools:context=".TruckRegister">

    <ImageView
        android:id="@+id/ivTrashTruck"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_trash_truck_white" />

    <TextView
        android:id="@+id/tvTruckRegister"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Cadastro de Veículo"
        android:textColor="#F2F1F1"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="@+id/ivTrashTruck"
        app:layout_constraintStart_toStartOf="@+id/ivTrashTruck"
        app:layout_constraintTop_toBottomOf="@id/ivTrashTruck" />

    <EditText
        android:id="@+id/etTruckModelRegister"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/edittext_border"
        android:ems="10"
        android:hint="  Modelo"
        android:inputType="text"
        android:textColorHint="#FDFDFD"
        app:layout_constraintEnd_toEndOf="@+id/tvTruckRegister"
        app:layout_constraintStart_toStartOf="@+id/tvTruckRegister"
        app:layout_constraintTop_toBottomOf="@+id/tvTruckRegister" />

    <EditText
        android:id="@+id/etTruckYearRegister"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/edittext_border"
        android:ems="10"
        android:hint="  Ano"
        android:inputType="number"
        android:textColorHint="#FDFDFD"
        app:layout_constraintEnd_toEndOf="@+id/etTruckModelRegister"
        app:layout_constraintStart_toStartOf="@+id/etTruckModelRegister"
        app:layout_constraintTop_toBottomOf="@+id/etTruckModelRegister" />


    <EditText
        android:id="@+id/etTruckPlateRegister"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/edittext_border"
        android:ems="10"
        android:hint="  Placa"
        android:inputType="text"
        android:textColorHint="#FDFDFD"
        app:layout_constraintEnd_toEndOf="@+id/etTruckYearRegister"
        app:layout_constraintStart_toStartOf="@+id/etTruckYearRegister"
        app:layout_constraintTop_toBottomOf="@+id/etTruckYearRegister" />

    <EditText
        android:id="@+id/etTruckBrandRegister"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/edittext_border"
        android:ems="10"
        android:hint="  Marca"
        android:inputType="number"
        android:textColorHint="#FDFDFD"
        app:layout_constraintEnd_toEndOf="@+id/etTruckPlateRegister"
        app:layout_constraintStart_toStartOf="@+id/etTruckPlateRegister"
        app:layout_constraintTop_toBottomOf="@+id/etTruckPlateRegister" />

    <Button
        android:id="@+id/btTruckRegister"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/white"
        android:text="Registrar"
        android:textColor="@color/blue"
        app:layout_constraintEnd_toEndOf="@+id/etTruckBrandRegister"
        app:layout_constraintTop_toBottomOf="@+id/etTruckBrandRegister" />


</androidx.constraintlayout.widget.ConstraintLayout>