<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fundo circular azul -->
    <item>
        <shape android:shape="oval">
            <size
                android:width="72dp"
                android:height="72dp" />
            <solid android:color="#2054D5" />
        </shape>
    </item>

    <!-- Caminhão centralizado e REDUZIDO para caber no círculo -->
    <item
        android:width="40dp"
        android:height="40dp"
        android:gravity="center">
        <bitmap
            android:src="@drawable/ic_trash_truck_white"
            android:antialias="true"
            android:tileMode="disabled" />
    </item>

</layer-list>
