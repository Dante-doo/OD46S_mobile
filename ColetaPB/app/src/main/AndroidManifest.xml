<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ColetaPB"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        <activity
            android:name=".StartRoute"
            android:exported="false"
            android:parentActivityName=".RouteList" />
        <!-- Tela inicial: Login -->
        <activity
            android:name=".LoginPage"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- Lista de caminhões (após login) -->
        <activity
            android:name=".TruckList"
            android:exported="false"
            android:parentActivityName=".LoginPage" /> <!-- Lista de rotas (filha da TruckList) -->
        <activity
            android:name=".RouteList"
            android:exported="false"
            android:parentActivityName=".TruckList" /> <!-- Você pode manter a MainActivity sem LAUNCHER, se quiser -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />
    </application>

</manifest>